# =============================================================
# 换行符统一用 LF
#
# 这个项目在 WSL 上开发，但可能有人在 Windows 上克隆。
# 不锁定的话 git 会按平台自动转换，gradlew 这种脚本一旦变成 CRLF
# 在 Linux/macOS 上就跑不起来了（报 "bad interpreter"）。
# =============================================================

* text=auto eol=lf

# 这些必须是 LF，否则直接罢工
*.sh        text eol=lf
gradlew     text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 批处理必须是 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制：别碰
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.keystore  binary
*.apk       binary
*.woff2     binary
